/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

# css/js are referenced with ?v=N in index.html — bump N when you change them.
/css/*
  Cache-Control: public, max-age=604800
/js/*
  Cache-Control: public, max-age=604800

# Asset file names have no hash, so no long-term caching: a replaced image must reach visitors within a week.
/assets/*
  Cache-Control: public, max-age=604800

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

/manifest.json
  Content-Type: application/manifest+json; charset=utf-8
